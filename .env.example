# EUMETSAT credentials (consumer key + secret from the EUMETSAT Data Store).
# They override the values saved in the web UI without persisting them. For
# normal operation it is enough to enter the credentials once in the web UI
# (http://<host>:6060/) - this file is only meant for cases where the
# credentials should not be stored in the /data volume (e.g. external
# secrets management).
EUMETSAT_CONSUMER_KEY=
EUMETSAT_CONSUMER_SECRET=

# Path to the configuration file (default: /data/config.yaml).
HA_SATIMAGE_CONFIG=/data/config.yaml

# Base directory for frames/configuration (default: /data). Only relevant
# for development/tests - in the container it stays the mounted /data
# volume.
# HA_SATIMAGE_DATA_DIR=/data

# UID/GID the service runs as (default 1000 = first user on most Linux
# hosts). Must have write access to the storage location chosen in the web
# UI, e.g. once: sudo install -d -o 1000 -g 1000 /mnt/data/ha_satimage
PUID=1000
PGID=1000

# Root directories whose subfolders the web UI suggests as storage locations.
# HA_SATIMAGE_STORAGE_ROOTS=/mnt:/media

# Base URL of the EUMETSAT Data Store API (source sync, only for tests).
# HA_SATIMAGE_EUMETSAT_API=https://api.eumetsat.int

# RSS maintenance schedule URL (only for tests).
# HA_SATIMAGE_MAINTENANCE_URL=https://user.eumetsat.int/resources/service-statuses/rss-schedule

# --- docker compose ---------------------------------------------------------
# Host directory mounted to /data; holds config.yaml, logs, cache and frames.
# Persists across image updates.
# HOST_DATA_DIR=./data

# Image tag to run (e.g. 1.0 to pin a minor release line).
# HA_SATIMAGE_TAG=latest

# Host port of the web UI / API.
# HA_SATIMAGE_PORT=6060

# Container-wide limits (require host cgroup support). PID limit includes
# threads; 128 is an initial ceiling, not a measured Raspberry Pi peak.
# HA_SATIMAGE_MEM_LIMIT=768m
# HA_SATIMAGE_CPUS=1.5
# HA_SATIMAGE_PIDS_LIMIT=128
